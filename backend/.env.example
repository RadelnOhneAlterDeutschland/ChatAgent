# Copy to backend/.env for local dev. Prod values live in AWS Secrets Manager
# and are injected as ECS task environment variables — never commit real secrets.

ENVIRONMENT=local

# App database (users, chat history, document metadata)
DATABASE_URL=postgresql+psycopg://chatagent:chatagent@localhost:5432/chatagent

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRY_MINUTES=30

# OpenAI
OPENAI_API_KEY=sk-...

# Pinecone (managed, not AWS-hosted)
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=chatagent-dev

# AWS
AWS_REGION=eu-west-1
S3_BUCKET_NAME=chatagent-documents-dev

# v2 only (plan.md Phase 3) — read-only role against the business SQL schema
# BUSINESS_DATABASE_URL=postgresql+psycopg://readonly:...@host:5432/business

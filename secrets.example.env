# Single source of truth for every secret/config key the backend needs.
#
# Usage:
#   cp secrets.example.env secrets.env
#   (edit secrets.env, fill in real values)
#
# `secrets.env` is what docker-compose actually loads (see docker-compose.yml's
# `env_file:`) — never commit it, it's gitignored. This file (secrets.example.env) stays
# in git as the template: keys only, no real values.
#
# What each key is for and where to get it: see SECRETS.md.

# --- App ---
ENVIRONMENT=
DATABASE_URL=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRY_MINUTES=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Optional. Chat only — points chat completions at an OpenAI-compatible endpoint (e.g.
# OpenRouter: https://openrouter.ai/api/v1). Leave blank for real OpenAI. Embeddings
# always use real OpenAI regardless — OpenRouter has no embeddings endpoint.
OPENAI_BASE_URL=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- AWS ---
AWS_REGION=
S3_BUCKET_NAME=
# Local dev: fill these in, or leave both blank and rely on ~/.aws/credentials instead.
# Prod (Phase 6): leave both BLANK. The EC2 instance has an IAM role attached
# (infra/aws-runbook.md) scoped to just this bucket + Textract; boto3's default credential
# chain finds those automatically with no key ever touching this file. If both are set,
# they take priority over the instance role — i.e. filling these in on the box would
# silently stop using it, so don't.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- PDF ingestion (Phase 2b: folder-sync) ---
INGESTION_FOLDER_PATHS=
SYSTEM_OWNER_EMAIL=

# --- v2 only (plan.md Phase 3), leave unset until the SQL tool is built ---
# BUSINESS_DATABASE_URL=

# --- Prod only (Phase 6): Caddy's site address, see infra/Caddyfile ---
# Local dev: leave blank, unused.
PUBLIC_SITE_ADDRESS=
